{
  "tasks": {
    "dev": "deno run --watch --allow-all main.tsx"
  },
  "imports": {
    "@sindresorhus/slugify": "npm:@sindresorhus/slugify@^3.0.1",
    "hono": "jsr:@hono/hono@^4.6.0",
    "moment": "npm:moment@^2.30.1"
  },
  "fmt": {
    "singleQuote": true,
    "semiColons": true,
    "lineWidth": 120,
    "useBraces": "always",
    "quoteProps": "asNeeded"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx"
  }
}
